# Copy to .env.local and fill in. Never commit .env.local or any file with real values.

# Public site URL (canonical links, sitemap, social cards). Not a secret.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Database. Leave empty for local development (uses ./data/baa.db) and for the
# throw-away demo mode on Vercel. For production use a hosted libSQL/Turso database:
# DATABASE_URL=libsql://your-database.turso.io
# DATABASE_AUTH_TOKEN=            # server-side only, never prefix with NEXT_PUBLIC_

# Password for the seeded admin accounts (12-72 characters). If empty, `npm run db:seed`
# generates a random one and prints it once.
# SEED_ADMIN_PASSWORD=
